# Salin berkas ini menjadi .env.local lalu isi nilainya (jangan di-commit).
# Ambil dari Supabase: Project Settings > API (Project URL dan kunci "anon" / "publishable").
#
# JANGAN pernah mengisi kunci "service_role" / "secret" di sini atau di repositori GitHub.
# Kunci anon aman berada di browser karena semua data dilindungi Row Level Security di database.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-dengan-kunci-anon-atau-publishable